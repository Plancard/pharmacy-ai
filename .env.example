# 이 파일을 복사해 .env를 만들고 값을 채운다:  cp .env.example .env
# .env는 커밋하지 않는다 (REQ-NF-07). 값이 비어 있는 항목이 필수다.
# 주석은 반드시 윗줄에 쓴다. 값 뒤에 붙이면 빈 값일 때 주석이 값으로 읽힌다.

# ---------- LLM (Agent) ----------
OPENAI_API_KEY=
# 명세서 2.5절: gpt-5-mini 날짜 버전 고정
OPENAI_MODEL=gpt-5-mini-2025-08-07
# 호출 1번 제한 시간(초), 자동 재시도 횟수 (기능분석서 6장)
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1

# ---------- 식약처 공공데이터 API (Agent) ----------
# 공공데이터포털 일반 인증키(Decoding)
DRUG_API_KEY=
DRUG_API_TIMEOUT_SECONDS=5
# 서비스 버전이 바뀔 때만 적는다
# DRUG_API_URL=
# 기본값: data/agent/drug_dictionary.json
# DRUG_DICTIONARY_PATH=

# ---------- 웹 (Flask) ----------
# 세션 서명용. 만들기: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# 서비스 테이블 + LangGraph 체크포인트 (DB 스키마 문서)
DATABASE_PATH=var/app.db
# 업로드 이미지 저장 위치 (처방 ID별 하위 폴더)
UPLOAD_DIR=var/uploads
# 업로드 크기 제한 MB (기능분석서 7장, 잠정)
MAX_UPLOAD_MB=10

# ---------- CV ----------
# 1 = cv/stub.py 가짜 모듈 사용, 0 = 실제 모델
CV_USE_STUB=1
# ok · mismatch · review · rotated · no_tray · ocr_empty
CV_STUB_SCENARIO=ok
CV_PILL_MODEL=models/pills_yolo26n.pt
CV_TRAY_MODEL=models/tray_yolo26n-pose.pt
# 저신뢰 기준 (REQ-CV-05, 잠정)
CV_CONF_MIN=0.5
