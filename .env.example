# 이 파일을 복사해 .env를 만들고 값을 채운다:  cp .env.example .env
# .env는 커밋하지 않는다 (REQ-NF-07). 값이 비어 있는 항목이 필수다.
# 주석은 반드시 윗줄에 쓴다. 값 뒤에 붙이면 빈 값일 때 주석이 값으로 읽힌다.

# ---------- LLM (Agent) ----------
OPENAI_API_KEY=
# 명세서 2.5절: gpt-5-mini 날짜 버전 고정
OPENAI_MODEL=gpt-5-mini-2025-08-07
# 호출 1번 제한 시간(초), 자동 재시도 횟수 (기능분석서 6장)
LLM_TIMEOUT_SECONDS=20
LLM_MAX_RETRIES=1

# ---------- 식약처 공공데이터 API (Agent) ----------
# 공공데이터포털 일반 인증키(Decoding)
DRUG_API_KEY=
# 의약품 · DUR API 호출 1번 제한 시간(초)과, 연결 실패 · 시간 초과일 때 다시 묻는 횟수
DRUG_API_TIMEOUT_SECONDS=10
DRUG_API_RETRIES=1
# 서비스 버전이 바뀔 때만 적는다
# DRUG_API_URL=
# DUR 품목정보 API 주소 (키는 DRUG_API_KEY를 같이 쓴다). 서비스 버전이 바뀔 때만 적는다
# DUR_API_URL=
# 기본값: agent/resources/drug_dictionary.json
# DRUG_DICTIONARY_PATH=
# 1 = 약품 매칭을 MCP 도구로 부른다 (python -m agent.mcp_server를 하위 프로세스로 띄움, 12단계). 0 = 함수로 직접
AGENT_USE_MCP=0
# 따로 띄운 MCP 서버(python -m agent.mcp_server --http)에 붙을 때만. 없으면 stdio로 하위 프로세스를 띄운다
# AGENT_MCP_URL=http://127.0.0.1:8765/mcp

# ---------- 웹 (Flask) ----------
# 세션 서명용. 만들기: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=
# 업로드 이미지·실행 중 파일 위치 (이미지는 VAR_DIR/uploads/<처방 ID>/)
VAR_DIR=var
# 화면 표시 시간대 (DB는 UTC로 저장)
DISPLAY_TZ=Asia/Seoul
# 2차 HTTPS 배포 때만 1 (세션 쿠키 https 전용, 프록시 헤더 신뢰)
SESSION_COOKIE_SECURE=0
TRUST_PROXY=0

# 업로드 크기 제한 MB (기능분석서 7장, 잠정)
MAX_UPLOAD_MB=10
# Agent 연결: fake(가짜 연결부, LangGraph interrupt가 붙기 전까지) · langgraph
AGENT_BACKEND=fake
# fake일 때 결과: warning(중복 경고) · none(위험 없음) · danger(병용금기) · flagged(대상 외 약품) · fail(OCR 실패)
FAKE_AGENT_SCENARIO=warning

# ---------- DB (PostgreSQL 16) ----------
# docker compose가 이 세 값으로 DB를 만든다. 비밀번호는 영문·숫자만 쓴다(접속 주소에 그대로 들어감)
POSTGRES_USER=pharmacy
POSTGRES_PASSWORD=
POSTGRES_DB=pharmacy
# 서비스 테이블 + LangGraph 체크포인트. 컨테이너 밖(flask run)에서 쓰는 주소이고,
# docker compose 안의 웹은 host를 db로 바꿔 자동으로 쓴다. CHANGE_ME를 POSTGRES_PASSWORD와 같은 값으로 바꾼다
DATABASE_URL=postgresql://pharmacy:CHANGE_ME@localhost:5432/pharmacy

# ---------- CV ----------
# 1 = cv/stub.py 가짜 모듈 사용, 0 = 실제 모델
CV_USE_STUB=1
# ok · mismatch · review · rotated · no_tray · ocr_empty
CV_STUB_SCENARIO=ok
CV_PILL_MODEL=models/pills_yolo26n.pt
CV_TRAY_MODEL=models/tray_yolo26n-pose.pt
# 저신뢰 기준 (REQ-CV-05, 잠정)
CV_CONF_MIN=0.5
